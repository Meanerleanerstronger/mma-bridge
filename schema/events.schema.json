{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmabridge.local/schema/events.schema.json",
  "title": "MMA Bridge events.json schema",
  "description": "Top-level array of event objects.",
  "type": "array",
  "items": { "$ref": "#/$defs/event" },

  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "date", "location", "fights"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "location": { "type": "string", "minLength": 1 },
        "venue": { "type": "string" },
        "poster": { "type": "string" },
        "promotion": { "type": "string" },

        "fights": {
          "type": "array",
          "items": { "$ref": "#/$defs/fight" }
        }
      }
    },

    "fight": {
      "type": "object",
      "additionalProperties": true,
      "required": ["red", "blue"],
      "properties": {
        "red": { "type": "string", "minLength": 1 },
        "blue": { "type": "string", "minLength": 1 },
        "weight_class": { "type": "string" },
        "is_main_event": { "type": "boolean" },
        "is_co_main": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
