{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmabridge.local/schema/fighters.schema.json",
  "title": "MMA Bridge fighters.json schema",
  "type": "object",

  "description": "Top-level object keyed by fighter slug. Each value is a fighter profile.",
  "additionalProperties": { "$ref": "#/$defs/fighter" },

  "$defs": {
    "fighter": {
      "type": "object",

      "description": "A fighter profile. Extra fields are allowed (stance, height, reach, age, etc.).",
      "additionalProperties": true,

      "required": ["name", "division", "record", "last5"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "nickname": { "type": "string" },
        "country": { "type": "string" },
        "flag": { "type": "string" },

        "division": { "type": "string", "minLength": 1 },

        "record": {
          "type": "string",
          "pattern": "^\\d{1,3}-\\d{1,3}(?:-\\d{1,3})?$",
          "description": "Examples: 28-1 or 19-1-1"
        },

        "last5": {
          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/fight_result" }
        }
      }
    },

    "fight_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opponent", "result", "method", "round", "date"],
      "properties": {
        "opponent": { "type": "string", "minLength": 1 },

        "result": {
          "type": "string",
          "enum": ["W", "L"]
        },

        "method": {
          "type": "string",
          "enum": [
            "KO",
            "TKO",
            "KO/TKO",
            "SUB",
            "DEC",
            "UD",
            "SD",
            "MD",
            "DQ",
            "NC"
          ],
          "description": "Accepts common MMA result labels used in your data."
        },

        "round": {
          "type": "string",
          "pattern": "^(?:[1-5]|N/A)$"
        },

        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "YYYY-MM-DD"
        }
      }
    }
  }
}
